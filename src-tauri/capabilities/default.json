{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "store:default",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" },
        { "url": "vscode://*" },
        { "url": "cursor://*" },
        { "url": "zed://*" },
        { "url": "idea://*" }
      ]
    }
  ]
}
